# MediAgent Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
HOST=0.0.0.0
DATABASE_PATH=server/mediagent.db
UPLOAD_DIR=server/uploads
PYTHON_EXECUTABLE=python3

# ── Authentication ──────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# ── CORS ────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production, e.g. https://your-app.vercel.app
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Translation (Task 5) ────────────────────────────────────────────────────
# TRANSLATION_PROVIDER: 'mymemory' or 'none' (dictionary fallback only)
TRANSLATION_PROVIDER=mymemory
# MYMEMORY_EMAIL: optional MyMemory contact email for higher rate limits
MYMEMORY_EMAIL=your-email@example.com

# ── ML / Python ─────────────────────────────────────────────────────────────
PYTHON_PATH=python3
ML_INFERENCE_TIMEOUT_MS=7000

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Backup ──────────────────────────────────────────────────────────────────
BACKUP_DIR=server/backups
BACKUP_RETENTION_DAYS=30
